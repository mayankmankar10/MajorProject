{
  "name": "smartserve-frontend",
  "version": "1.0.0",
  "description": "SmartServe - AI-Powered Recruitment Platform Frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
